{
  "name": "cancunio",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cancunio-db",
      "database_id": "1d4b8796-af3f-4383-95bf-0520054fbe6b"
    }
  ]
}
